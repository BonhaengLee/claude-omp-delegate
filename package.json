{
  "name": "claude-omp-delegate",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/package-plugin.mjs",
    "verify": "npm run typecheck && npm test",
    "check:package": "node scripts/check-package.mjs",
    "check:public": "node scripts/check-public.mjs",
    "release:archive": "node scripts/release-archive.mjs",
    "check:omp-compat": "node scripts/check-omp-compat.mjs",
    "e2e:host": "npm run package && node scripts/host-e2e.mjs",
    "marketplace:set": "node scripts/set-marketplace-release.mjs",
    "marketplace:verify": "node scripts/set-marketplace-release.mjs --verify",
    "marketplace:check": "node scripts/set-marketplace-release.mjs --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "typescript": "5.9.3"
  },
  "description": "Durable, profile-independent Claude plugin delegation to a local OMP runner.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BonhaengLee/claude-omp-delegate.git"
  },
  "homepage": "https://github.com/BonhaengLee/claude-omp-delegate#readme",
  "license": "MIT"
}
